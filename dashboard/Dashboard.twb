    <worksheet name='GDP % Change YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='gdp_states' name='federated.1bdz9mj0zyg39016kol4f0l29god' />
          </datasources>
          <datasource-dependencies datasource='federated.1bdz9mj0zyg39016kol4f0l29god'>
            <column caption='GDP % Change YoY' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(MAX([GDP])) - LOOKUP(ZN(MAX([GDP])), -1)) / ABS(LOOKUP(ZN(MAX([GDP])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' name='[GDP]' role='measure' type='quantitative' />
            <column caption='NAISC' datatype='string' name='[NAICS]' role='dimension' type='nominal' />
            <column caption='State/Region' datatype='string' name='[STATE/REGION]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Year' datatype='date' name='[YEAR]' role='dimension' type='quantitative' />
            <column-instance column='[NAICS]' derivation='None' name='[none:NAICS:nk]' pivot='key' type='nominal' />
            <column-instance column='[STATE/REGION]' derivation='None' name='[none:STATE/REGION:nk]' pivot='key' type='nominal' />
            <column-instance column='[YEAR]' derivation='Year-Trunc' name='[tyr:YEAR:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1bdz9mj0zyg39016kol4f0l29god].[none:NAICS:nk]'>
            <groupfilter function='member' level='[none:NAICS:nk]' member='&quot;..0&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1bdz9mj0zyg39016kol4f0l29god].[none:STATE/REGION:nk]' filter-group='3'>
            <groupfilter function='member' level='[none:STATE/REGION:nk]' member='&quot;GA&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1bdz9mj0zyg39016kol4f0l29god].[Action (State/Region)]</column>
            <column>[federated.1bdz9mj0zyg39016kol4f0l29god].[none:NAICS:nk]</column>
            <column>[federated.1bdz9mj0zyg39016kol4f0l29god].[none:STATE/REGION:nk]</column>
          </slices>
          <aggregation value='true' />
