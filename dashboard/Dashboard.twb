    <worksheet name='Industry % Change YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='gdp_states' name='federated.1bdz9mj0zyg39016kol4f0l29god' />
          </datasources>
          <datasource-dependencies datasource='federated.1bdz9mj0zyg39016kol4f0l29god'>
            <column caption='GDP % Change YoY' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(MAX([GDP])) - LOOKUP(ZN(MAX([GDP])), -1)) / ABS(LOOKUP(ZN(MAX([GDP])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' name='[GDP]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Level' datatype='integer' name='[LEVEL]' role='dimension' type='ordinal' />
            <column caption='NAISC Desc' datatype='string' name='[NAICS_LDESC]' role='dimension' type='nominal' />
            <column caption='State/Region' datatype='string' name='[STATE/REGION]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Year' datatype='date' name='[YEAR]' role='dimension' type='quantitative' />
            <column-instance column='[LEVEL]' derivation='None' name='[none:LEVEL:ok]' pivot='key' type='ordinal' />
            <column-instance column='[NAICS_LDESC]' derivation='None' name='[none:NAICS_LDESC:nk]' pivot='key' type='nominal' />
            <column-instance column='[STATE/REGION]' derivation='None' name='[none:STATE/REGION:nk]' pivot='key' type='nominal' />
            <column-instance column='[YEAR]' derivation='Year-Trunc' name='[tyr:YEAR:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1bdz9mj0zyg39016kol4f0l29god].[none:LEVEL:ok]'>
            <groupfilter function='member' level='[none:LEVEL:ok]' member='0' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1bdz9mj0zyg39016kol4f0l29god].[none:NAICS_LDESC:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Arts, entertainment, recreation, accommodation, and food services&quot;' />
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Educational services, health care, and social assistance&quot;' />
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Finance, insurance, real estate, rental, and leasing&quot;' />
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Manufacturing and information&quot;' />
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Natural resources and mining&quot;' />
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Professional and business services&quot;' />
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Trade&quot;' />
              <groupfilter function='member' level='[none:NAICS_LDESC:nk]' member='&quot;Transportation and utilities&quot;' />
