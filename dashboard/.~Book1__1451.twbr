      <aliases enabled='yes' />
      <column caption='Bea Group' datatype='string' name='[BEA_GROUP]' role='dimension' type='nominal' />
      <column caption='GDP % Change YoY' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(MAX([GDP])) - LOOKUP(ZN(MAX([GDP])), -1)) / ABS(LOOKUP(ZN(MAX([GDP])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GDP Capita' datatype='real' name='[Calculation_5643071814213632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GDP] / [EST_POP]' />
      </column>
      <column caption='Min Year GDP' datatype='real' name='[Calculation_5643071822966787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF YEAR([YEAR]) = {MIN(YEAR([YEAR]))} THEN [GDP] END)' />
      </column>
      <column caption='Max Year GDP' datatype='real' name='[Calculation_5643071823679492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF YEAR([YEAR]) = {MAX(YEAR([YEAR]))} THEN [GDP] END)' />
      </column>
      <column caption='GDP Change' datatype='real' default-format='p0.00%' name='[Calculation_5643071824150533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5643071823679492] - [Calculation_5643071822966787]) / [Calculation_5643071822966787]' />
      </column>
      <column caption='GDP / MAX GDP' datatype='real' name='[Calculation_5920836047122433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GDP] / {FIXED YEAR([YEAR]), [STATE/REGION] : MAX([GDP])}' />
      </column>
      <column caption='Import Exposure' datatype='real' default-format='p0.00%' name='[Calculation_5920837080129541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[IMPORT_VAL] / [GDP]' />
      </column>
      <column caption='Export Exposure' datatype='real' default-format='p0.00%' name='[Calculation_5920837082308614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[EXPORT_VAL] / [GDP]' />
      </column>
      <column caption='Population' datatype='integer' name='[EST_POP]' role='measure' type='quantitative' />
      <column caption='Export Val' datatype='integer' name='[EXPORT_VAL]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Exp Level' datatype='integer' name='[EXP_LEVEL]' role='dimension' type='ordinal' />
      <column caption='Exp Naics' datatype='integer' name='[EXP_NAICS]' role='measure' type='quantitative' />
      <column caption='Exp Naics Desc' datatype='string' name='[EXP_NAICS_DESC]' role='dimension' type='nominal' />
      <column caption='GDP Capita Change' datatype='real' default-format='p0.00%' name='[GDP Change (copy)_5920836056690692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Max Year GDP (copy)_5920836056023042] - [Min Year GDP (copy)_5920836056104963]) / [Min Year GDP (copy)_5920836056104963]' />
